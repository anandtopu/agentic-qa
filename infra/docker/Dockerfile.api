# syntax=docker/dockerfile:1.7
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv from the official image (small static binary).
COPY --from=ghcr.io/astral-sh/uv:0.4.20 /uv /usr/local/bin/uv

WORKDIR /app

# ---- Dependency layer ----
# Copy only files needed to resolve the workspace, then sync. This keeps
# the heavy install layer cached when only application code changes.
COPY pyproject.toml uv.lock* ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY packages/redaction/pyproject.toml packages/redaction/pyproject.toml
COPY packages/agents/pyproject.toml packages/agents/pyproject.toml
COPY packages/tools/pyproject.toml packages/tools/pyproject.toml
COPY packages/eval/pyproject.toml packages/eval/pyproject.toml

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-install-project --no-dev || uv sync --no-dev

# ---- Application layer ----
COPY apps/api ./apps/api
COPY packages ./packages

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-dev

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "aqao_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
