# Copy to .env and fill in. Real secrets must never be committed.
# All variables are validated at startup by apps/api/src/qaforge_api/config.py.

# --- Core ---
QAFORGE_ENV=local                  # local | dev | staging | prod
QAFORGE_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
QAFORGE_API_HOST=0.0.0.0
QAFORGE_API_PORT=8000

# --- Database (PostgreSQL) ---
QAFORGE_DATABASE_URL=postgresql+psycopg://qaforge:qaforge@localhost:5432/qaforge

# --- Redis (queue + cache) ---
QAFORGE_REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO local; S3/GCS in cloud) ---
QAFORGE_S3_ENDPOINT_URL=http://localhost:9000
QAFORGE_S3_BUCKET=qaforge-evidence
QAFORGE_S3_ACCESS_KEY=minioadmin
QAFORGE_S3_SECRET_KEY=minioadmin
QAFORGE_S3_REGION=us-east-1

# --- LLM providers (set at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
QAFORGE_DEFAULT_MODEL=claude-sonnet-4-6

# --- Auth ---
QAFORGE_JWT_SECRET=replace-me-with-32-bytes-of-randomness
QAFORGE_OIDC_ISSUER=
QAFORGE_OIDC_CLIENT_ID=
QAFORGE_OIDC_CLIENT_SECRET=

# --- GitHub integration ---
QAFORGE_GITHUB_APP_ID=
QAFORGE_GITHUB_APP_PRIVATE_KEY_PATH=
QAFORGE_GITHUB_WEBHOOK_SECRET=

# --- Observability ---
QAFORGE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
QAFORGE_OTEL_SERVICE_NAME=qaforge-api

# --- Cost & runtime guards (per workspace defaults) ---
QAFORGE_DEFAULT_MAX_COST_USD_PER_RUN=5.00
QAFORGE_DEFAULT_MAX_RUNTIME_MINUTES=30
