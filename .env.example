# Copy to .env and fill in. Real secrets must never be committed.
# All variables are validated at startup by apps/api/src/aqao_api/config.py.

# --- Core ---
AQAO_ENV=local                  # local | dev | staging | prod
AQAO_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
AQAO_API_HOST=0.0.0.0
AQAO_API_PORT=8000

# --- Database (PostgreSQL) ---
AQAO_DATABASE_URL=postgresql+psycopg://aqao:aqao@localhost:5432/aqao

# --- Redis (queue + cache) ---
AQAO_REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO local; S3/GCS in cloud) ---
AQAO_S3_ENDPOINT_URL=http://localhost:9000
AQAO_S3_BUCKET=aqao-evidence
AQAO_S3_ACCESS_KEY=minioadmin
AQAO_S3_SECRET_KEY=minioadmin
AQAO_S3_REGION=us-east-1

# --- LLM providers (set at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AQAO_DEFAULT_MODEL=claude-sonnet-4-6

# --- Auth ---
AQAO_JWT_SECRET=replace-me-with-32-bytes-of-randomness
AQAO_OIDC_ISSUER=
AQAO_OIDC_CLIENT_ID=
AQAO_OIDC_CLIENT_SECRET=

# --- GitHub integration ---
AQAO_GITHUB_APP_ID=
AQAO_GITHUB_APP_PRIVATE_KEY_PATH=
AQAO_GITHUB_WEBHOOK_SECRET=

# --- Observability ---
AQAO_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
AQAO_OTEL_SERVICE_NAME=aqao-api

# --- Cost & runtime guards (per workspace defaults) ---
AQAO_DEFAULT_MAX_COST_USD_PER_RUN=5.00
AQAO_DEFAULT_MAX_RUNTIME_MINUTES=30
